{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-gateway/openrouter-free",
  "providers": {
    "local-gateway": {
      "name": "OpenRouter + Gemini (local gateway)",
      "env": ["OPENCODE_GATEWAY_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "openrouter-free": { "name": "OpenRouter Free (router)" },
        "gemini-flash": { "name": "Gemini Flash" }
      }
    }
  }
}
